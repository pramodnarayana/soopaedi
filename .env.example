# ==============================================================================
# EDI AS2 Local Development Environment Variables
# Copy this file to .env to override default configuration values locally.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=DEBUG

# Database Configuration (Overrides default localhost DB)
DB_URL=postgresql+asyncpg://edi:edi_password@localhost:5432/edi
DB_POOL_SIZE=10

# LocalStack S3 Configuration
S3_BUCKET=edi-as2-payloads
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# OpenTelemetry Configuration
OTEL_ENABLED=True
OTEL_SERVICE_NAME=edi-as2-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Identity & SSO Configuration
# If Zitadel auto-generated a different Client ID for your provider, paste it here.
IDENTITY_OAUTH_CLIENT_ID=api-gateway
